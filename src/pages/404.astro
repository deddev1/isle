---
import PageLayout from '../layouts/PageLayout.astro';
import InternalLinksPanel from '../components/InternalLinksPanel.astro';
import { getPageHero } from '../data/theisle';
const pageHero = getPageHero('notFound');
---

<PageLayout
	title="Page Not Found | islecheats"
	description="This page could not be found on islecheats.net. Browse The Isle Cheats, ESP guides, pricing, FAQ, features, and blog articles from the homepage — start exploring now."
	heading="Page not found"
	intro="The page you requested does not exist or may have moved. Use the links below to find The Isle Cheats guides, pricing, and support."
	heroImage={pageHero.src}
	heroAlt={pageHero.alt}
	noindex={true}
	includeCanonical={false}
	ctaPrimary={{ href: '/', label: 'Back to Homepage' }}
	ctaSecondary={{ href: '/the-isle-guide/', label: 'The Isle Guide' }}
>
	<InternalLinksPanel currentPath="/404/" />
</PageLayout>
