---
import PageLayout from '../../layouts/PageLayout.astro';
import InternalLinksPanel from '../../components/InternalLinksPanel.astro';
import { siteConfig } from '../../data/site';
import { getPageSeo } from '../../data/seo/meta';
import { getPageHero, getPageGallery } from '../../data/theisle';

const seo = getPageSeo('terms');
const pageHero = getPageHero('terms');
---

<PageLayout
	title={seo.title}
	description={seo.description}
	canonicalPath="/terms/"
	heading="Terms of Use"
	intro="Terms covering use of islecheats.net and purchases related to The Isle Cheats packages."
	eyebrow="Legal"
	heroImage={pageHero.src}
	heroAlt={pageHero.alt}
	gallery={getPageGallery('espRadarTopdown', 'espBeachCarnotaurus', 'espRadarMinimapCombat')}
	ctaPrimary={{ href: '/pricing/', label: 'View Pricing' }}
	ctaSecondary={{ href: '/privacy-policy/', label: 'Privacy Policy' }}
	keywords={seo.keywords}
	ogTitle={seo.ogTitle}
	ogDescription={seo.ogDescription}
	twitterTitle={seo.twitterTitle}
	twitterDescription={seo.twitterDescription}
>
	<section class="card-panel">
		<h2>Website use</h2>
		<p>
			You may browse product information, pricing, updates, and support pages for personal research and
			purchase decisions. Do not attempt to disrupt the site or misuse published materials.
		</p>
	</section>

	<section class="card-panel">
		<h2>Digital products</h2>
		<p>
			Packages are sold as digital access for the selected duration. Features and availability can change when
			updates are required. Refund conditions are described in the
			<a href="/refund-policy/">Refund Policy</a>.
		</p>
	</section>

	<section class="card-panel">
		<h2>Contact</h2>
		<p>
			Questions about these terms can be sent to {siteConfig.supportEmail}.
		</p>
	</section>

	<InternalLinksPanel currentPath="/terms/" />
</PageLayout>