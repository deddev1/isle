---
import PageLayout from '../../layouts/PageLayout.astro';
import InternalLinksPanel from '../../components/InternalLinksPanel.astro';
import { homeFaqs, siteConfig } from '../../data/site';
import { extendedFaqs } from '../../data/seo/content';
import { getPageSeo } from '../../data/seo/meta';
import { buildFaqSchema } from '../../data/seo/schema';
import { getPageHero, getPageGallery } from '../../data/theisle';

const seo = getPageSeo('faq');

const faqs = [
	...extendedFaqs,
	{
		question: 'Can I get a refund?',
		answer:
			'Refund eligibility depends on the conditions published on the Refund Policy page. Review that page before purchasing.',
	},
];

const faqSchema = buildFaqSchema(faqs);
const pageHero = getPageHero('faq');
---

<PageLayout
	title={seo.title}
	description={seo.description}
	canonicalPath="/faq/"
	heading="The Isle Cheats FAQ"
	intro="Straight answers about The Isle Cheats features, packages, delivery, and support."
	heroImage={pageHero.src}
	heroAlt={pageHero.alt}
	gallery={getPageGallery('nightHunt', 'predatorStalk', 'tyrannosaurForest')}
	ctaPrimary={{ href: '/support/', label: 'Open Support' }}
	ctaSecondary={{ href: '/pricing/', label: 'View Pricing' }}
	keywords={seo.keywords}
	ogTitle={seo.ogTitle}
	ogDescription={seo.ogDescription}
	twitterTitle={seo.twitterTitle}
	twitterDescription={seo.twitterDescription}
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	{
		faqs.map((item) => (
			<section class="card-panel">
				<h2>{item.question}</h2>
				<p>{item.answer}</p>
			</section>
		))
	}

	<section class="card-panel">
		<h2>Still need help?</h2>
		<p>
			Visit <a href="/support/">Support</a> for delivery, setup, and billing help, or open the <a href={siteConfig.supportUrl} target="_blank" rel="noopener noreferrer">support portal</a> directly.
		</p>
	</section>

	<InternalLinksPanel />
</PageLayout>
