---
import PageLayout from '../../layouts/PageLayout.astro';
import InternalLinksPanel from '../../components/InternalLinksPanel.astro';
import { cloudDmaOption, productInfo } from '../../data/site';
import { getPageSeo } from '../../data/seo/meta';
import { getPageHero, getPageGallery } from '../../data/theisle';

const seo = getPageSeo('cheats');
const pageHero = getPageHero('cheats');
---

<PageLayout
	title={seo.title}
	description={seo.description}
	canonicalPath="/cheats/"
	heading="Cheats"
	intro="Hacks inside The Isle Cheats, including Instant Rotation, Auto-Attack, Omnimovement, and other combat and movement options. Included in the Cloud-DMA package."
	heroImage={pageHero.src}
	heroAlt={pageHero.alt}
	gallery={getPageGallery('aimbotAllosaurusDamageLog', 'combatLogTriceratopsFight', 'aimbotHeadshotSkeleton')}
	ctaPrimary={{ href: '/pricing/', label: 'Choose a Package' }}
	ctaSecondary={{ href: '/theisle-esp/', label: 'Explore ESP' }}
	keywords={seo.keywords}
	ogTitle={seo.ogTitle}
	ogDescription={seo.ogDescription}
	twitterTitle={seo.twitterTitle}
	twitterDescription={seo.twitterDescription}
>
	<section class="card-panel">
		<h2>Cheat features</h2>
		<ul>
			{productInfo.features.cheats.map((item) => <li>{item}</li>)}
		</ul>
	</section>

	<section class="card-panel">
		<h2>Cloud-DMA option</h2>
		<p>
			{cloudDmaOption.summary} See the <a href="/features/">Features</a> page for the full Cloud-DMA
			breakdown.
		</p>
	</section>

	<section class="card-panel">
		<h2>Related pages</h2>
		<ul>
			<li><a href="/the-isle-cheats/">The Isle Cheats hub</a></li>
			<li><a href="/the-isle-esp/">Visuals ESP and World ESP guide</a></li>
			<li><a href="/the-isle-features/">The Isle Features</a></li>
			<li><a href="/features/">Complete feature list</a></li>
			<li><a href="/pricing/">Pricing and package lengths</a></li>
			<li><a href="/the-isle-faq/">The Isle FAQ</a></li>
			<li><a href="/blog/">The Isle Blog</a></li>
		</ul>
	</section>

	<InternalLinksPanel />
</PageLayout>
