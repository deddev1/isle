---
import PageLayout from '../../layouts/PageLayout.astro';
import InternalLinksPanel from '../../components/InternalLinksPanel.astro';
import { cloudDmaOption, productInfo } from '../../data/site';
import { getPageSeo } from '../../data/seo/meta';
import { featuresFaqs } from '../../data/seo/features-content';
import { buildFaqSchema } from '../../data/seo/schema';
import { getPageHero, getPageGallery } from '../../data/theisle';

const seo = getPageSeo('features');
const pageHero = getPageHero('features');
const faqSchema = buildFaqSchema(featuresFaqs);
---

<PageLayout
	title={seo.title}
	description={seo.description}
	canonicalPath="/features/"
	heading="The Isle Cheats Features"
	intro="Compare Cloud-DMA, Visuals ESP, World ESP, Cheats, and Other hacks in one place before choosing a duration on Pricing."
	heroImage={pageHero.src}
	heroAlt={pageHero.alt}
	gallery={getPageGallery('swampEnvironment', 'hero', 'tyrannosaurForest')}
	ctaPrimary={{ href: '/pricing/', label: 'Compare Pricing' }}
	ctaSecondary={{ href: '/faq/', label: 'Read FAQ' }}
	keywords={seo.keywords}
	ogTitle={seo.ogTitle}
	ogDescription={seo.ogDescription}
	twitterTitle={seo.twitterTitle}
	twitterDescription={seo.twitterDescription}
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<section class="card-panel">
		<h2>{cloudDmaOption.label} option</h2>
		<p>{cloudDmaOption.summary}</p>
		<ul>
			<li>Visuals ESP (WH)</li>
			<li>World ESP (Environment)</li>
			<li>Cheats (Instant Rotation, Auto-Attack, and more)</li>
			<li>Other (The Isle) utilities</li>
			<li>Not included: {cloudDmaOption.excludes.join(', ')}</li>
		</ul>
	</section>

	<section class="card-panel">
		<h2>Visuals ESP (WH)</h2>
		<ul>
			{productInfo.features.visualsEsp.map((item) => <li>{item}</li>)}
		</ul>
		<div class="cta-row">
			<a class="cta-btn cta-btn--ghost" href="/theisle-esp/">ESP details</a>
		</div>
	</section>

	<section class="card-panel">
		<h2>World ESP (Environment)</h2>
		<ul>
			{productInfo.features.worldEsp.map((item) => <li>{item}</li>)}
		</ul>
	</section>

	<section class="card-panel">
		<h2 id="cheats">Cheats</h2>
		<ul>
			{productInfo.features.cheats.map((item) => <li>{item}</li>)}
		</ul>
		<div class="cta-row">
			<a class="cta-btn cta-btn--ghost" href="/cheats/">Cheats details</a>
		</div>
	</section>

	<section class="card-panel" id="other">
		<h2>Other (The Isle)</h2>
		<ul>
			{productInfo.features.other.map((item) => <li>{item}</li>)}
		</ul>
	</section>

	<section class="card-panel" id="aimbot">
		<h2>Aimbot (not in Cloud-DMA)</h2>
		<p>Aimbot is available outside the Cloud-DMA option. Cloud-DMA buyers receive ESP, Cheats, and Other hacks only.</p>
		<ul>
			{productInfo.features.aimbot.map((item) => <li>{item}</li>)}
		</ul>
	</section>

	<section class="card-panel">
		<h2>General package features</h2>
		<ul>
			{productInfo.features.general.map((item) => <li>{item}</li>)}
		</ul>
	</section>

	<section class="card-panel">
		<h2>Features FAQ</h2>
		{
			featuresFaqs.map((item) => (
				<>
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</>
			))
		}
	</section>

	<InternalLinksPanel />
</PageLayout>
