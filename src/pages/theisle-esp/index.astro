---
import PageLayout from '../../layouts/PageLayout.astro';
import { productInfo } from '../../data/site';
import { getPageSeo } from '../../data/seo/meta';
import { getPageHero, getPageGallery } from '../../data/theisle';

const seo = getPageSeo('theisleEsp');
const pageHero = getPageHero('theisleEsp');
---

<PageLayout
	title={seo.title}
	description={seo.description}
	canonicalPath="/theisle-esp/"
	heading="The Isle Cheats ESP"
	intro="Visuals ESP and World ESP for entity awareness, resource tracking, and environment readouts. Both are included in the Cloud-DMA option."
	heroImage={pageHero.src}
	heroAlt={pageHero.alt}
	gallery={getPageGallery('tyrannosaurForest', 'predatorStalk', 'swampEnvironment')}
	ctaPrimary={{ href: '/pricing/', label: 'View Pricing' }}
	ctaSecondary={{ href: '/cheats/', label: 'See Cheats' }}
	keywords={seo.keywords}
	ogTitle={seo.ogTitle}
	ogDescription={seo.ogDescription}
	twitterTitle={seo.twitterTitle}
	twitterDescription={seo.twitterDescription}
>
	<section class="card-panel">
		<h2>Visuals ESP (WH)</h2>
		<ul>
			{productInfo.features.visualsEsp.map((item) => <li>{item}</li>)}
		</ul>
	</section>

	<section class="card-panel" id="world-esp">
		<h2>World ESP (Environment)</h2>
		<ul>
			{productInfo.features.worldEsp.map((item) => <li>{item}</li>)}
		</ul>
	</section>

	<section class="card-panel">
		<h2>Related pages</h2>
		<ul>
			<li><a href="/cheats/">Cheats</a></li>
			<li><a href="/features/">All The Isle Cheats features</a></li>
			<li><a href="/pricing/">Pricing and package lengths</a></li>
			<li><a href="/faq/">ESP and delivery FAQ</a></li>
		</ul>
	</section>
</PageLayout>
