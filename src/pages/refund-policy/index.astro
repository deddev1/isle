---
import PageLayout from '../../layouts/PageLayout.astro';
import InternalLinksPanel from '../../components/InternalLinksPanel.astro';
import { siteConfig } from '../../data/site';
import { getPageSeo } from '../../data/seo/meta';
import { getPageHero, getPageGallery } from '../../data/theisle';

const seo = getPageSeo('refundPolicy');
const pageHero = getPageHero('refundPolicy');
---

<PageLayout
	title={seo.title}
	description={seo.description}
	canonicalPath="/refund-policy/"
	heading="Refund Policy"
	intro="When The Isle Cheats purchases may be reviewed for a refund, and how to request a review."
	eyebrow="Legal"
	heroImage={pageHero.src}
	heroAlt={pageHero.alt}
	gallery={getPageGallery('combatLogCeratosaurusHead', 'combatLogTriceratopsFight', 'espRadarGlowJungle')}
	ctaPrimary={{ href: '/pricing/', label: 'View Pricing' }}
	ctaSecondary={{ href: '/faq/', label: 'Browse FAQ' }}
	keywords={seo.keywords}
	ogTitle={seo.ogTitle}
	ogDescription={seo.ogDescription}
	twitterTitle={seo.twitterTitle}
	twitterDescription={seo.twitterDescription}
>
	<section class="card-panel">
		<h2>Eligibility overview</h2>
		<p>
			Digital products are reviewed case by case. A refund request is more likely to be considered when the
			order was not successfully delivered or when a verified billing error occurred.
		</p>
	</section>

	<section class="card-panel">
		<h2>Requests that may be declined</h2>
		<ul>
			<li>Change-of-mind requests after a license has been delivered and used</li>
			<li>Requests that do not include valid order information</li>
			<li>Issues caused by unsupported systems or incomplete setup steps</li>
		</ul>
	</section>

	<section class="card-panel">
		<h2>How to request a review</h2>
		<p>
			Email {siteConfig.supportEmail} with your order reference and a short explanation. The team will confirm
			whether a refund or replacement path applies.
		</p>
	</section>

	<InternalLinksPanel currentPath="/refund-policy/" />
</PageLayout>