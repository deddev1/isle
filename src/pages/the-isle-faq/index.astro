---
import SeoContentPage from '../../components/SeoContentPage.astro';
import { extendedFaqs } from '../../data/seo/content';
import { getPageHero } from '../../data/theisle';

const pageHero = getPageHero('theIsleFaq');
---

<SeoContentPage
	seoKey="theIsleFaq"
	canonicalPath="/the-isle-faq/"
	heading="The Isle FAQ"
	intro="Answers to the most common questions about The Isle Cheats, ESP overlays, Cloud-DMA, pricing, Windows compatibility, and support."
	heroImage={pageHero.src}
	heroAlt={pageHero.alt}
	faqs={extendedFaqs}
	ctaPrimary={{ href: '/pricing/', label: 'View Pricing' }}
	ctaSecondary={{ href: '/faq/', label: 'Full FAQ Hub' }}
>
	{
		extendedFaqs.map((item) => (
			<section class="card-panel">
				<h2>{item.question}</h2>
				<p>{item.answer}</p>
			</section>
		))
	}

</SeoContentPage>
