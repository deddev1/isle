---
import SeoContentPage from '../../components/SeoContentPage.astro';
import { extendedFaqs } from '../../data/seo/content';
import { siteConfig } from '../../data/site';
import { theIsleImages } from '../../data/theisle';
---

<SeoContentPage
	seoKey="theIsleFaq"
	canonicalPath="/the-isle-faq/"
	heading="The Isle FAQ"
	intro="Answers to the most common questions about The Isle Cheats, ESP overlays, Cloud-DMA, pricing, Windows compatibility, and support."
	heroImage={theIsleImages.product[3].src}
	heroAlt="The Isle FAQ visual"
	faqs={extendedFaqs}
	ctaPrimary={{ href: '/support/', label: 'Contact Support' }}
	ctaSecondary={{ href: '/faq/', label: 'Full FAQ Hub' }}
>
	{
		extendedFaqs.map((item) => (
			<section class="card-panel">
				<h2>{item.question}</h2>
				<p>{item.answer}</p>
			</section>
		))
	}

	<section class="card-panel">
		<h2>Still need help?</h2>
		<p>
			Visit <a href="/support/">Support</a> or email
			<a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>.
		</p>
	</section>
</SeoContentPage>
