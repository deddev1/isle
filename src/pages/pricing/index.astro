---
import PageLayout from '../../layouts/PageLayout.astro';
import InternalLinksPanel from '../../components/InternalLinksPanel.astro';
import { productInfo, siteConfig } from '../../data/site';
import { getPageSeo } from '../../data/seo/meta';
import { pricingFaqs, pricingSections } from '../../data/seo/pricing-content';
import { buildFaqSchema, buildSoftwareApplicationSchema } from '../../data/seo/schema';
import { getPageHero, getPageGallery } from '../../data/theisle';

const seo = getPageSeo('pricing');
const pageHero = getPageHero('pricing');
const faqSchema = buildFaqSchema(pricingFaqs);
const productSchema = buildSoftwareApplicationSchema({
	name: productInfo.name,
	description: productInfo.summary,
	pricingUrl: new URL('/pricing/', siteConfig.url).href,
	plans: productInfo.plans.map((plan) => ({ label: plan.label, price: plan.price })),
	currency: productInfo.currency,
	alternateName: ['Isle Cheats', 'The Isle Hack'],
	keywords: seo.keywords,
});
---

<PageLayout
	title={seo.title}
	description={seo.description}
	canonicalPath="/pricing/"
	heading="The Isle Cheats Pricing"
	intro="Packages are sold in USD and include The Isle Cheats Cloud-DMA, ESP, and Cheats product line."
	heroImage={pageHero.src}
	heroAlt={pageHero.alt}
	gallery={getPageGallery('herdPlains', 'carnivoreCombat', 'packEncounter')}
	ctaPrimary={{ href: '/#product', label: 'Open Product Card' }}
	ctaSecondary={{ href: '/features/', label: 'See Features' }}
	keywords={seo.keywords}
	ogTitle={seo.ogTitle}
	ogDescription={seo.ogDescription}
	twitterTitle={seo.twitterTitle}
	twitterDescription={seo.twitterDescription}
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

	<section class="card-panel">
		<h2>Current packages</h2>
		<div class="price-grid">
			{
				productInfo.plans.map((plan) => (
					<article class:list={['price-card', { 'is-featured': plan.id === 'lifetime' }]}>
						<span class="price-card__label">{plan.label}</span>
						<span class="price-card__price">${plan.price}</span>
						<span class="price-card__meta">{productInfo.currency} · Cloud-DMA · ESP</span>
					</article>
				))
			}
		</div>
	</section>

	{
		pricingSections.map((section) => (
			<section class="card-panel" id={section.id}>
				<h2>{section.heading}</h2>
				{section.paragraphs.map((paragraph) => (
					<p>{paragraph}</p>
				))}
				{section.bullets && (
					<ul>
						{section.bullets.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				)}
			</section>
		))
	}

	<section class="card-panel">
		<h2>Pricing FAQ</h2>
		{
			pricingFaqs.map((item) => (
				<>
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</>
			))
		}
	</section>

	<section class="card-panel">
		<h2>Before you buy</h2>
		<ul>
			<li><a href="/refund-policy/">Read the refund policy</a></li>
			<li><a href="/terms/">Review the terms</a></li>
			<li><a href="/updates/">Check the latest updates</a></li>
			<li><a href={siteConfig.supportUrl} target="_blank" rel="noopener noreferrer">Contact support</a> if you need order help</li>
			<li><a href="/blog/the-isle-cheat-price-guide/">Read the cheat price guide</a></li>
			<li><a href="/blog/the-isle-monthly-vs-lifetime/">Compare monthly vs lifetime</a></li>
		</ul>
	</section>

	<InternalLinksPanel />
</PageLayout>
