---
import PageLayout from '../../layouts/PageLayout.astro';
import InternalLinksPanel from '../../components/InternalLinksPanel.astro';
import { productInfo, siteConfig } from '../../data/site';
import { getPageSeo } from '../../data/seo/meta';
import { supportFaqs, supportSections } from '../../data/seo/support-content';
import { buildFaqSchema } from '../../data/seo/schema';
import { getPageHero, getPageGallery } from '../../data/theisle';

const seo = getPageSeo('support');
const pageHero = getPageHero('support');
const faqSchema = buildFaqSchema(supportFaqs);
---

<PageLayout
	title={seo.title}
	description={seo.description}
	canonicalPath="/support/"
	heading="The Isle Cheats Support"
	intro="Get help with orders, digital delivery, or package setup for The Isle Cheats."
	heroImage={pageHero.src}
	heroAlt={pageHero.alt}
	gallery={getPageGallery('espBeachPlayerTags', 'espBeachHealthBars', 'espRadarDeinosuchus')}
	ctaSecondary={{ href: '/faq/', label: 'Browse FAQ' }}
	keywords={seo.keywords}
	ogTitle={seo.ogTitle}
	ogDescription={seo.ogDescription}
	twitterTitle={seo.twitterTitle}
	twitterDescription={seo.twitterDescription}
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

	<section class="card-panel">
		<h2>Contact</h2>
		<p>Email: {siteConfig.supportEmail}</p>
		<p>{productInfo.supportHours}.</p>
	</section>

	{
		supportSections.map((section) => (
			<section class="card-panel" id={section.id}>
				<h2>{section.heading}</h2>
				{section.paragraphs.map((paragraph) => (
					<p>{paragraph}</p>
				))}
				{section.bullets && (
					<ul>
						{section.bullets.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				)}
			</section>
		))
	}

	<section class="card-panel">
		<h2>Support FAQ</h2>
		{
			supportFaqs.map((item) => (
				<>
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</>
			))
		}
	</section>

	<section class="card-panel">
		<h2>Useful links</h2>
		<ul>
			<li><a href="/faq/">FAQ</a></li>
			<li><a href="/pricing/">Pricing</a></li>
			<li><a href="/updates/">Updates</a></li>
			<li><a href="/refund-policy/">Refund Policy</a></li>
			<li><a href="/blog/the-isle-support-guide/">The Isle support guide</a></li>
			<li><a href="/blog/the-isle-delivery-process/">License delivery process</a></li>
		</ul>
	</section>

	<InternalLinksPanel />
</PageLayout>
