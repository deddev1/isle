---
import PageLayout from '../../layouts/PageLayout.astro';
import InternalLinksPanel from '../../components/InternalLinksPanel.astro';
import { productInfo, siteConfig } from '../../data/site';
import { getPageSeo } from '../../data/seo/meta';
import { getPageHero, getPageGallery } from '../../data/theisle';

const seo = getPageSeo('support');
const pageHero = getPageHero('support');
---

<PageLayout
	title={seo.title}
	description={seo.description}
	canonicalPath="/support/"
	heading="The Isle Cheats Support"
	intro="Get help with orders, digital delivery, or package setup for The Isle Cheats."
	heroImage={pageHero.src}
	heroAlt={pageHero.alt}
	gallery={getPageGallery('riversideDrink', 'herdPlains', 'hero')}
	ctaPrimary={{ href: siteConfig.supportUrl, label: 'Open Support' }}
	ctaSecondary={{ href: '/faq/', label: 'Browse FAQ' }}
	keywords={seo.keywords}
	ogTitle={seo.ogTitle}
	ogDescription={seo.ogDescription}
	twitterTitle={seo.twitterTitle}
	twitterDescription={seo.twitterDescription}
>
	<section class="card-panel">
		<h2>Contact</h2>
		<p>
			Support portal: <a href={siteConfig.supportUrl} target="_blank" rel="noopener noreferrer">{siteConfig.supportUrl}</a>
		</p>
		<p>{productInfo.supportHours}.</p>
	</section>

	<section class="card-panel">
		<h2>Include these details</h2>
		<ul>
			<li>Order ID or payment reference</li>
			<li>Package duration purchased</li>
			<li>Clear description of the issue</li>
			<li>Screenshots when they help explain the problem</li>
		</ul>
	</section>

	<section class="card-panel">
		<h2>Useful links</h2>
		<ul>
			<li><a href="/faq/">FAQ</a></li>
			<li><a href="/updates/">Updates</a></li>
			<li><a href="/refund-policy/">Refund Policy</a></li>
			<li><a href="/pricing/">Pricing</a></li>
		</ul>
	</section>
	<InternalLinksPanel />
</PageLayout>
