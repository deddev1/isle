---
import PageLayout from '../../layouts/PageLayout.astro';
import InternalLinksPanel from '../../components/InternalLinksPanel.astro';
import { siteConfig } from '../../data/site';
import { getPageSeo } from '../../data/seo/meta';
import { getPageHero, getPageGallery } from '../../data/theisle';

const seo = getPageSeo('privacyPolicy');
const pageHero = getPageHero('privacyPolicy');
---

<PageLayout
	title={seo.title}
	description={seo.description}
	canonicalPath="/privacy-policy/"
	heading="Privacy Policy"
	intro="How information is handled when you browse islecheats.net or contact support."
	eyebrow="Legal"
	heroImage={pageHero.src}
	heroAlt={pageHero.alt}
	gallery={getPageGallery('espBeachCarnotaurus', 'espBeachPlayerTags', 'espRadarMinimapCombat')}
	ctaPrimary={{ href: '/pricing/', label: 'View Pricing' }}
	ctaSecondary={{ href: '/terms/', label: 'Terms of Use' }}
	keywords={seo.keywords}
	ogTitle={seo.ogTitle}
	ogDescription={seo.ogDescription}
	twitterTitle={seo.twitterTitle}
	twitterDescription={seo.twitterDescription}
>
	<section class="card-panel">
		<h2>Information we may collect</h2>
		<ul>
			<li>Contact details you send by email</li>
			<li>Order references needed to resolve support requests</li>
			<li>Basic technical data used to operate and secure the website</li>
		</ul>
	</section>

	<section class="card-panel">
		<h2>How information is used</h2>
		<p>
			Information is used to respond to support requests, process order issues, improve site reliability, and
			meet legal obligations when required.
		</p>
	</section>

	<section class="card-panel">
		<h2>Contact</h2>
		<p>
			Privacy questions can be sent to {siteConfig.supportEmail}.
		</p>
	</section>

	<InternalLinksPanel />
</PageLayout>