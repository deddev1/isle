---
import type { LocaleCode } from '../data/i18n';
import { resolveLocalizedHref } from '../data/i18n';
import { getHomeContent } from '../data/i18n/home-content';
import { theIsleImages } from '../data/theisle';

interface Props {
	locale?: LocaleCode;
}

const { locale = 'en' } = Astro.props;
const content = getHomeContent(locale);
const primaryHref = resolveLocalizedHref('/pricing/', locale);
const featuresHref = '/features/';
---

<section class="hero" id="home" data-nav-section="home" aria-label="Hero">
	<div class="hero__media">
		<img
			src="/images/the-isle-hero-dinosaur-survival-1280.webp"
			srcset="/images/the-isle-hero-dinosaur-survival-800.webp 800w, /images/the-isle-hero-dinosaur-survival-1280.webp 1280w, /images/the-isle-hero-dinosaur-survival-1600.webp 1600w, /images/the-isle-hero-dinosaur-survival.webp 1920w"
			sizes="100vw"
			alt="The Isle Cheats hero banner — ESP, Cloud-DMA hacks, and dinosaur survival on Windows PC"
			class="hero__bg"
			width="1400"
			height="788"
			fetchpriority="high"
			decoding="async"
		/>
		<div class="hero__splash" aria-hidden="true"></div>
		<div class="hero__veil" aria-hidden="true"></div>
	</div>

	<div class="hero__inner">
		<div class="hero__copy">
			<p class="hero__eyebrow">{content.heroEyebrow}</p>
			<h1 class="hero__title">{content.heroTitle}</h1>
			<p class="hero__subtitle text-gradient">{content.heroSubtitle}</p>
			<p class="hero__desc">{content.heroDescription}</p>
			<div class="hero__cta">
				<a href={primaryHref} class="hero__btn hero__btn--primary bg-brand">{content.heroCtaPrimary}</a>
				<a href={featuresHref} class="hero__btn hero__btn--ghost">{content.heroCtaSecondary}</a>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		isolation: isolate;
		min-height: clamp(300px, 40vw, 420px);
	}

	.hero__media {
		position: absolute;
		inset: 0;
		z-index: 0;
	}

	.hero__bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: 70% 40%;
		transform: translateZ(0) scale(1.03);
		backface-visibility: hidden;
		/* Delay motion until after LCP settle */
		animation: kenburns 18s ease-in-out 2.5s infinite alternate;
	}

	.hero__splash {
		position: absolute;
		inset: 0;
		background:
			radial-gradient(ellipse 55% 80% at 78% 45%, rgba(168, 85, 247, 0.55), transparent 70%),
			radial-gradient(ellipse 40% 60% at 92% 70%, rgba(217, 70, 239, 0.35), transparent 65%),
			radial-gradient(ellipse 35% 50% at 60% 20%, rgba(124, 58, 237, 0.4), transparent 70%);
		mix-blend-mode: color;
		pointer-events: none;
		animation: pulse-glow 7s ease-in-out infinite;
	}

	.hero__veil {
		position: absolute;
		inset: 0;
		background:
			linear-gradient(90deg, #0a0612 0%, rgba(10, 6, 18, 0.92) 34%, rgba(10, 6, 18, 0.35) 62%, rgba(10, 6, 18, 0.55) 100%),
			linear-gradient(180deg, rgba(10, 6, 18, 0.35) 0%, transparent 40%, rgba(10, 6, 18, 0.75) 100%);
		pointer-events: none;
	}

	.hero__inner {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: center;
		width: min(100% - (var(--page-gutter) * 2), var(--page-max));
		margin: 0 auto;
		padding: 3rem 0 2.5rem;
		min-height: inherit;
	}

	.hero__copy {
		max-width: min(42rem, 100%);
		min-width: 0;
		animation: rise-in 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.hero__eyebrow {
		margin: 0 0 0.85rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-orchid);
	}

	.hero__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.55rem, 3.6vw, 2.85rem);
		font-weight: 800;
		line-height: 1.15;
		letter-spacing: -0.03em;
		text-shadow: 0 8px 32px rgba(10, 6, 18, 0.65);
		white-space: nowrap;
		hyphens: none;
	}

	.hero__subtitle {
		margin: 0.35em 0 0;
		font-family: var(--font-display);
		font-size: clamp(1.1rem, 2.5vw, 1.75rem);
		font-weight: 800;
		line-height: 1.2;
		letter-spacing: -0.02em;
		background-size: 200% 100%;
		animation:
			rise-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both,
			shimmer 4s ease-in-out infinite;
		text-wrap: balance;
	}

	.hero__desc {
		margin: 0.75rem 0 0;
		max-width: 28rem;
		color: var(--color-muted);
		font-size: clamp(0.88rem, 1.4vw, 0.98rem);
		font-weight: 500;
		line-height: 1.55;
		animation: rise-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.14s both;
	}

	.hero__cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.6rem;
		animation: rise-in 0.9s cubic-bezier(0.22, 1, 0.36, 1) 0.18s both;
	}

	.hero__btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-width: 9.25rem;
		min-height: 2.55rem;
		padding: 0.7rem 1.05rem;
		border-radius: 0.7rem;
		font-size: 0.88rem;
		font-weight: 700;
		text-align: center;
		transition:
			transform 0.2s ease,
			filter 0.2s ease,
			background 0.2s ease,
			border-color 0.2s ease;
	}

	.hero__btn--primary {
		color: white;
		box-shadow: 0 8px 18px rgba(0, 0, 0, 0.3);
	}

	.hero__btn--primary:hover {
		transform: translateY(-1px);
		filter: brightness(1.05);
	}

	.hero__btn--ghost {
		border: 1px solid rgba(192, 132, 252, 0.35);
		background: rgba(18, 16, 26, 0.55);
		color: var(--color-ink);
		backdrop-filter: blur(8px);
	}

	.hero__btn--ghost:hover {
		border-color: rgba(192, 132, 252, 0.6);
		background: rgba(48, 36, 72, 0.65);
	}

	@keyframes rise-in {
		from {
			opacity: 0;
			transform: translateY(18px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@keyframes kenburns {
		from {
			transform: translateZ(0) scale(1.04) translate3d(0, 0, 0);
		}
		to {
			transform: translateZ(0) scale(1.1) translate3d(-1.5%, 1%, 0);
		}
	}

	@keyframes pulse-glow {
		0%,
		100% {
			opacity: 0.85;
		}
		50% {
			opacity: 1;
		}
	}

	@keyframes shimmer {
		0%,
		100% {
			background-position: 0% 50%;
		}
		50% {
			background-position: 100% 50%;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.hero__bg,
		.hero__splash,
		.hero__copy,
		.hero__subtitle,
		.hero__desc,
		.hero__cta,
		.hero__accent {
			animation: none;
		}
	}

	@media (max-width: 760px) {
		.hero {
			min-height: min(58svh, 440px);
		}

		.hero__bg {
			object-position: center 28%;
		}

		.hero__veil {
			background:
				linear-gradient(180deg, rgba(10, 6, 18, 0.62) 0%, rgba(10, 6, 18, 0.42) 38%, rgba(10, 6, 18, 0.94) 100%),
				linear-gradient(90deg, rgba(10, 6, 18, 0.6), transparent 72%);
		}

		.hero__inner {
			align-items: flex-end;
			padding-top: 5.25rem;
			padding-bottom: 1.75rem;
			min-height: inherit;
		}

		.hero__copy {
			max-width: none;
			width: 100%;
		}

		.hero__eyebrow {
			margin-bottom: 0.65rem;
			font-size: 0.7rem;
			letter-spacing: 0.12em;
		}

		.hero__title {
			font-size: clamp(1.35rem, 7vw, 2.1rem);
			line-height: 1.2;
			letter-spacing: -0.025em;
		}

		.hero__subtitle {
			margin-top: 0.4rem;
			font-size: clamp(1.15rem, 5.5vw, 1.65rem);
			line-height: 1.22;
		}

		.hero__desc {
			margin-top: 0.65rem;
			font-size: 0.95rem;
			max-width: none;
		}

		.hero__cta {
			flex-direction: column;
			align-items: stretch;
			gap: 0.65rem;
			margin-top: 1.25rem;
			width: 100%;
		}

		.hero__btn {
			width: 100%;
			min-height: 2.85rem;
			padding: 0.8rem 1rem;
			font-size: 0.92rem;
		}
	}

	@media (max-width: 380px) {
		.hero__title {
			font-size: 1.25rem;
			line-height: 1.22;
		}

		.hero__subtitle {
			font-size: 1.05rem;
		}
	}
</style>
