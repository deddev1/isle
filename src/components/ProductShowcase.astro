---
import HomeVideoPlayer from './HomeVideoPlayer.astro';
import ProductCard from './ProductCard.astro';
---

<div class="showcase">
	<div class="showcase__media">
		<div class="showcase__video">
			<HomeVideoPlayer compact />
		</div>
		<div class="showcase__gallery">
			<ProductCard variant="gallery" />
		</div>
	</div>
	<aside class="showcase__pricing">
		<ProductCard variant="pricing" />
	</aside>
</div>

<style>
	.showcase {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		align-items: start;
	}

	.showcase__media,
	.showcase__pricing {
		min-width: 0;
	}

	.showcase__media {
		display: grid;
		gap: 0.75rem;
	}

	.showcase__gallery :global(.product),
	.showcase__video :global(.home-video) {
		width: 100%;
	}

	@media (min-width: 960px) {
		.showcase {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
			gap: 1.35rem;
			align-items: stretch;
		}

		.showcase__media {
			display: flex;
			flex-direction: column;
			gap: 0.65rem;
			align-self: stretch;
			min-height: 0;
		}

		.showcase__video {
			flex: 0 0 auto;
		}

		.showcase__video :global(.home-video--compact) {
			height: 100%;
		}

		.showcase__video :global(.home-video--compact .home-video__trigger),
		.showcase__video :global(.home-video--compact .home-video__player) {
			aspect-ratio: 16 / 9;
			min-height: 0;
		}

		.showcase__gallery {
			flex: 1 1 auto;
			display: flex;
			min-height: 0;
		}

		.showcase__gallery :global(.product--gallery) {
			flex: 1;
			min-height: 0;
			width: 100%;
		}

		.showcase__pricing {
			align-self: stretch;
		}

		.showcase__pricing :global(.product--pricing) {
			height: 100%;
		}
	}

	@media (max-width: 959px) {
		.showcase__media {
			order: 1;
		}

		.showcase__pricing {
			order: 2;
		}
	}
</style>
