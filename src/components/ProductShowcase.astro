---
import HomeVideoPlayer from './HomeVideoPlayer.astro';
import ProductCard from './ProductCard.astro';
import { theIsleImages } from '../data/theisle';

const scrollImages = theIsleImages.product.slice(0, 8);
---

<div class="showcase">
	<div class="showcase__media">
		<div class="showcase__video">
			<HomeVideoPlayer compact />
		</div>

		<div class="showcase__scroll" aria-label="Gameplay preview images">
			<div class="showcase__scroll-track" role="list">
				{
					scrollImages.map((image) => (
						<figure class="showcase__scroll-item" role="listitem">
							<img
								src={image.src}
								alt={image.alt}
								width="320"
								height="180"
								loading="lazy"
								decoding="async"
							/>
						</figure>
					))
				}
			</div>
		</div>
	</div>

	<aside class="showcase__pricing">
		<ProductCard variant="pricing" />
	</aside>
</div>

<style>
	.showcase {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		align-items: start;
	}

	.showcase__media,
	.showcase__pricing {
		min-width: 0;
	}

	.showcase__media {
		display: grid;
		gap: 0.65rem;
	}

	.showcase__video :global(.home-video) {
		width: 100%;
	}

	.showcase__scroll {
		min-width: 0;
		border-radius: 0.75rem;
		border: 1px solid rgba(168, 85, 247, 0.14);
		background: rgba(10, 6, 18, 0.35);
		padding: 0.45rem;
	}

	.showcase__scroll-track {
		display: flex;
		gap: 0.45rem;
		overflow-x: auto;
		overflow-y: hidden;
		scroll-snap-type: x mandatory;
		-webkit-overflow-scrolling: touch;
		scrollbar-width: thin;
		scrollbar-color: rgba(168, 85, 247, 0.45) transparent;
		padding-bottom: 0.15rem;
	}

	.showcase__scroll-track::-webkit-scrollbar {
		height: 5px;
	}

	.showcase__scroll-track::-webkit-scrollbar-track {
		background: transparent;
	}

	.showcase__scroll-track::-webkit-scrollbar-thumb {
		background: rgba(168, 85, 247, 0.4);
		border-radius: 999px;
	}

	.showcase__scroll-item {
		flex: 0 0 8.5rem;
		margin: 0;
		overflow: hidden;
		border-radius: 0.5rem;
		border: 1px solid rgba(168, 85, 247, 0.16);
		background: #12081f;
		aspect-ratio: 16 / 10;
		scroll-snap-align: start;
	}

	.showcase__scroll-item img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (min-width: 960px) {
		.showcase {
			grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
			gap: 1.35rem;
			align-items: stretch;
		}

		.showcase__media {
			display: flex;
			flex-direction: column;
			gap: 0.65rem;
			align-self: stretch;
			min-height: 0;
		}

		.showcase__video {
			flex: 0 0 auto;
		}

		.showcase__video :global(.home-video--compact) {
			height: 100%;
		}

		.showcase__video :global(.home-video--compact .home-video__trigger),
		.showcase__video :global(.home-video--compact .home-video__player) {
			aspect-ratio: 16 / 9;
			min-height: 0;
		}

		.showcase__scroll {
			flex: 0 0 auto;
		}

		.showcase__scroll-item {
			flex-basis: 9.25rem;
		}

		.showcase__pricing {
			align-self: stretch;
		}

		.showcase__pricing :global(.product--pricing) {
			height: 100%;
		}
	}

	@media (max-width: 959px) {
		.showcase__media {
			order: 1;
		}

		.showcase__pricing {
			order: 2;
		}

		.showcase__scroll-item {
			flex-basis: 7.5rem;
		}
	}
</style>
