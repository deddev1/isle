---
import { getWhyUsContent } from '../data/i18n/why-us-content';
import { resolveLocalizedHref, type LocaleCode } from '../data/i18n';

interface Props {
	locale?: LocaleCode;
}

const { locale = 'en' } = Astro.props;
const whyUs = getWhyUsContent(locale);
const resolveCtaHref = (href: string) => {
	if (href.startsWith('/')) return resolveLocalizedHref(href, locale);
	return href;
};
---

<div class="home-seo shell home-seo--why-us" aria-labelledby="why-us-title">
	<div class="home-seo__panel card-surface">
		<h2 id="why-us-title">{whyUs.heading}</h2>
		<p class="home-seo__subheading">{whyUs.subheading}</p>
		<p class="home-seo__intro">{whyUs.intro}</p>

		<div class="why-us__grid">
			{
				whyUs.highlights.map((item) => (
					<article class="why-us__card">
						<h3>{item.title}</h3>
						<p class="why-us__lead">{item.lead}</p>
						<ul class="home-seo__bullets">
							{item.bullets.map((bullet) => (
								<li>{bullet}</li>
							))}
						</ul>
					</article>
				))
			}
		</div>

		<p class="why-us__closing">{whyUs.closing}</p>

		<div class="home-seo__share-row home-seo__cta-row">
			{
				whyUs.ctas.map((cta) => (
					<a
						class="share-link"
						href={resolveCtaHref(cta.href)}
						{...(cta.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
					>
						{cta.label}
					</a>
				))
			}
		</div>
		<p class="home-seo__footnote">{whyUs.footnote}</p>
	</div>
</div>

<style>
	.home-seo--why-us {
		padding-bottom: 0;
	}

	.card-surface {
		padding: clamp(1.25rem, 3vw, 1.75rem);
		border-radius: var(--radius-card);
		border: 1px solid rgba(168, 85, 247, 0.16);
		background: rgba(26, 22, 38, 0.72);
	}

	.home-seo--why-us h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.5vw, 1.75rem);
		font-weight: 800;
	}

	.home-seo__subheading {
		margin: 0.45rem 0 0;
		color: var(--color-orchid);
		font-size: 0.92rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.home-seo__intro,
	.why-us__closing {
		margin: 0.85rem 0 0;
		color: var(--color-muted);
		line-height: 1.65;
		max-width: 52rem;
	}

	.why-us__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.75rem;
		margin-top: 1.15rem;
	}

	.why-us__card {
		padding: 0.95rem 1rem;
		border-radius: 0.85rem;
		border: 1px solid rgba(168, 85, 247, 0.14);
		background: rgba(10, 6, 18, 0.35);
	}

	.why-us__card h3 {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1rem;
		font-weight: 800;
		line-height: 1.3;
		color: var(--color-ink);
	}

	.why-us__lead {
		margin: 0.45rem 0 0;
		color: var(--color-muted);
		font-size: 0.9rem;
		line-height: 1.5;
	}

	.home-seo__bullets {
		margin: 0.7rem 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.4rem;
	}

	.home-seo__bullets li {
		position: relative;
		padding: 0.45rem 0.65rem 0.45rem 1.55rem;
		border-radius: 0.55rem;
		border: 1px solid rgba(168, 85, 247, 0.08);
		background: rgba(26, 22, 38, 0.55);
		color: #d4cae6;
		font-size: 0.84rem;
		line-height: 1.45;
	}

	.home-seo__bullets li::before {
		content: '';
		position: absolute;
		left: 0.6rem;
		top: 50%;
		width: 0.32rem;
		height: 0.32rem;
		border-radius: 999px;
		background: var(--color-orchid);
		transform: translateY(-50%);
	}

	.home-seo__footnote {
		margin: 1rem 0 0;
		font-size: 0.82rem;
		color: var(--color-faint);
		line-height: 1.5;
	}

	.home-seo__cta-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 1.15rem;
	}

	.share-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.5rem;
		padding: 0.55rem 0.95rem;
		border-radius: 0.7rem;
		border: 1px solid rgba(192, 132, 252, 0.25);
		background: rgba(34, 28, 48, 0.85);
		color: var(--color-ink);
		font-size: 0.88rem;
		font-weight: 700;
		transition:
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.share-link:hover {
		border-color: rgba(192, 132, 252, 0.5);
		background: rgba(48, 36, 72, 0.9);
		color: var(--color-ink);
	}

	@media (max-width: 760px) {
		.why-us__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
