---
import PageLayout from '../layouts/PageLayout.astro';
import InternalLinksPanel from './InternalLinksPanel.astro';
import { productInfo, siteConfig } from '../data/site';
import { getPageSeo } from '../data/seo/meta';
import { pricingFaqs, pricingSections } from '../data/seo/pricing-content';
import { buildFaqSchema, buildSoftwareApplicationSchema } from '../data/seo/schema';
import { getPricingContent } from '../data/i18n/pricing-content';
import { getPageHero, getPageGallery, theIsleImages } from '../data/theisle';
import { getLocalizedPath, resolveLocalizedHref, type LocaleCode } from '../data/i18n';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const seo = getPageSeo('pricing', locale);
const content = getPricingContent(locale);
const canonicalPath = getLocalizedPath('/pricing/', locale);
const homePath = getLocalizedPath('/', locale);
const pageHero = getPageHero('pricing');
const previewScroll = theIsleImages.product;
const beforeBuyItems = content.beforeBuyItems;
const faqSchema = buildFaqSchema(pricingFaqs);
const productSchema = buildSoftwareApplicationSchema({
	name: productInfo.name,
	description: productInfo.summary,
	pricingUrl: new URL(canonicalPath, siteConfig.url).href,
	plans: productInfo.plans.map((plan) => ({ label: plan.label, price: plan.price })),
	currency: productInfo.currency,
	alternateName: ['Isle Cheats', 'The Isle Hack'],
	keywords: seo.keywords,
});

const planBullets = {
	monthly: [
		'30-day license',
		'Lowest upfront cost',
		'Same Cloud-DMA features as lifetime',
		'Renew only when you still need access',
	],
	lifetime: [
		'One-time payment',
		'No renewal billing',
		'Same Cloud-DMA features as monthly',
		'Best for frequent players',
	],
} as const;

const ctaPrimary = {
	...content.ctaPrimary,
	href: content.ctaPrimary.href.startsWith('/#')
		? `${homePath}${content.ctaPrimary.href.slice(1)}`
		: resolveLocalizedHref(content.ctaPrimary.href, locale),
};
const ctaSecondary = {
	...content.ctaSecondary,
	href: resolveLocalizedHref(content.ctaSecondary.href, locale),
};
---

<PageLayout
	title={seo.title}
	description={seo.description}
	canonicalPath={canonicalPath}
	heading={content.heading}
	intro={content.intro}
	heroImage={pageHero.src}
	heroAlt={pageHero.alt}
	previewScroll={previewScroll}
	gallery={getPageGallery('espRadarMinimapCombat', 'espBeachPlayerTags', 'combatLogTriceratopsFight')}
	ctaPrimary={ctaPrimary}
	ctaSecondary={ctaSecondary}
	keywords={seo.keywords}
	ogTitle={seo.ogTitle}
	ogDescription={seo.ogDescription}
	twitterTitle={seo.twitterTitle}
	twitterDescription={seo.twitterDescription}
	locale={locale}
	breadcrumbLabel={content.breadcrumbLabel}
	compact
>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

	<section class="card-panel">
		<h2>{content.packagesHeading}</h2>
		<p>{content.packagesLead}</p>
		<div class="price-grid">
			{
				productInfo.plans.map((plan) => (
					<article class:list={['price-card', { 'is-featured': plan.id === 'lifetime' }]}>
						<span class="price-card__label">{plan.label}</span>
						<span class="price-card__price">${plan.price}</span>
						<span class="price-card__meta">{productInfo.currency} · Cloud-DMA · ESP</span>
						<ul class="price-card__list">
							{(planBullets[plan.id as keyof typeof planBullets] ?? []).map((item) => (
								<li>{item}</li>
							))}
						</ul>
					</article>
				))
			}
		</div>
	</section>

	{
		pricingSections.map((section) => (
			<section class="card-panel" id={section.id}>
				<h2>{section.heading}</h2>
				{section.lead && <p class="price-lead">{section.lead}</p>}
				{section.paragraphs?.map((paragraph) => (
					<p>{paragraph}</p>
				))}
				{section.subsections?.map((sub) => (
					<>
						<h3>{sub.heading}</h3>
						{sub.paragraphs?.map((paragraph) => (
							<p>{paragraph}</p>
						))}
						{sub.bullets && (
							<ul>
								{sub.bullets.map((item) => (
									<li>{item}</li>
								))}
							</ul>
						)}
					</>
				))}
				{section.bullets && (
					<ul>
						{section.bullets.map((item) => (
							<li>{item}</li>
						))}
					</ul>
				)}
			</section>
		))
	}

	<section class="card-panel">
		<h2>{content.faqHeading}</h2>
		<p>{content.faqLead}</p>
		{
			pricingFaqs.map((item) => (
				<>
					<h3>{item.question}</h3>
					<p>{item.answer}</p>
				</>
			))
		}
	</section>

	<section class="card-panel">
		<h2>{content.beforeBuyHeading}</h2>
		<p>{content.beforeBuyLead}</p>
		<ul>
			{
				beforeBuyItems.map((item) => (
					<li>
						<a href={resolveLocalizedHref(item.href, locale)}>{item.label}</a>
					</li>
				))
			}
		</ul>
	</section>

	<InternalLinksPanel currentPath={canonicalPath} />
</PageLayout>

<style>
	.price-lead {
		margin: 0.35rem 0 0.75rem;
		color: #d4cae6;
		line-height: 1.6;
	}

	.price-card__list {
		margin: 0.75rem 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.35rem;
		width: 100%;
		text-align: left;
	}

	.price-card__list li {
		position: relative;
		padding: 0.35rem 0.5rem 0.35rem 1.35rem;
		border-radius: 0.45rem;
		background: rgba(10, 6, 18, 0.35);
		border: 1px solid rgba(168, 85, 247, 0.1);
		color: #d4cae6;
		font-size: 0.82rem;
		line-height: 1.4;
	}

	.price-card__list li::before {
		content: '';
		position: absolute;
		left: 0.55rem;
		top: 50%;
		width: 0.3rem;
		height: 0.3rem;
		border-radius: 999px;
		background: var(--color-orchid);
		transform: translateY(-50%);
	}

	.price-card.is-featured .price-card__list li {
		background: rgba(255, 255, 255, 0.1);
		border-color: rgba(255, 255, 255, 0.16);
		color: rgba(255, 255, 255, 0.94);
	}

	.price-card.is-featured .price-card__list li::before {
		background: #fff;
	}
</style>
