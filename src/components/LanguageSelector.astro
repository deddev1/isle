---
import { getLocaleFromPath, getLanguageSwitchHref, locales } from '../data/i18n';

const currentPath = Astro.url.pathname;
const activeLocale = getLocaleFromPath(currentPath);
const active = locales.find((locale) => locale.code === activeLocale) ?? locales[0];
---

<div class="lang-dropdown" data-lang-dropdown>
	<button
		type="button"
		class="lang-dropdown__trigger"
		data-lang-trigger
		aria-haspopup="listbox"
		aria-expanded="false"
		aria-controls="lang-dropdown-menu"
		id="lang-dropdown-label"
	>
		<span class="lang-dropdown__flag" aria-hidden="true">{active.flag}</span>
		<span class="lang-dropdown__current">{active.label}</span>
		<span class="lang-dropdown__chevron" aria-hidden="true"></span>
	</button>

	<div class="lang-dropdown__menu" id="lang-dropdown-menu" role="listbox" aria-labelledby="lang-dropdown-label" hidden>
		{
			locales.map((locale) => {
				const href = getLanguageSwitchHref(currentPath, locale.code);
				const isActive = locale.code === activeLocale;

				return (
					<a
						href={href}
						class:list={['lang-dropdown__option', { 'is-active': isActive }]}
						role="option"
						aria-selected={isActive}
						hreflang={locale.hrefLang}
						lang={locale.code}
						data-lang={locale.code}
					>
						<span class="lang-dropdown__flag" aria-hidden="true">{locale.flag}</span>
						<span class="lang-dropdown__option-text">
							<span class="lang-dropdown__option-label">{locale.label}</span>
							<span class="lang-dropdown__option-country">{locale.country}</span>
						</span>
					</a>
				);
			})
		}
	</div>
</div>

<script>
	const dropdowns = document.querySelectorAll('[data-lang-dropdown]');

	dropdowns.forEach((root) => {
		const trigger = root.querySelector('[data-lang-trigger]');
		const menu = root.querySelector('.lang-dropdown__menu');

		if (!(trigger instanceof HTMLButtonElement) || !(menu instanceof HTMLElement)) return;

		const close = () => {
			menu.hidden = true;
			trigger.setAttribute('aria-expanded', 'false');
			root.classList.remove('is-open');
		};

		const open = () => {
			menu.hidden = false;
			trigger.setAttribute('aria-expanded', 'true');
			root.classList.add('is-open');
		};

		const toggle = () => {
			if (menu.hidden) open();
			else close();
		};

		trigger.addEventListener('click', (event) => {
			event.stopPropagation();
			toggle();
		});

		document.addEventListener('click', (event) => {
			if (!root.contains(event.target as Node)) close();
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') close();
		});
	});
</script>

<style>
	.lang-dropdown {
		position: relative;
		min-width: 0;
	}

	.lang-dropdown__trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		min-width: 8.5rem;
		max-width: 11rem;
		height: 2.35rem;
		padding: 0 0.75rem 0 0.65rem;
		border-radius: 0.75rem;
		border: 1px solid rgba(129, 140, 248, 0.22);
		background: rgba(99, 102, 241, 0.12);
		color: var(--color-ink);
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		cursor: pointer;
		transition:
			border-color 0.2s ease,
			background 0.2s ease,
			box-shadow 0.2s ease;
	}

	.lang-dropdown__trigger:hover,
	.lang-dropdown.is-open .lang-dropdown__trigger {
		border-color: rgba(167, 139, 250, 0.38);
		background: rgba(76, 29, 149, 0.22);
		box-shadow: 0 0 18px rgba(99, 102, 241, 0.18);
	}

	.lang-dropdown__trigger:focus-visible {
		outline: 2px solid rgba(167, 139, 250, 0.85);
		outline-offset: 2px;
	}

	.lang-dropdown__flag {
		font-size: 1rem;
		line-height: 1;
		flex-shrink: 0;
	}

	.lang-dropdown__current {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		text-align: left;
	}

	.lang-dropdown__chevron {
		width: 0.45rem;
		height: 0.45rem;
		border-right: 2px solid currentColor;
		border-bottom: 2px solid currentColor;
		transform: rotate(45deg) translateY(-1px);
		transition: transform 0.2s ease;
		flex-shrink: 0;
		opacity: 0.75;
	}

	.lang-dropdown.is-open .lang-dropdown__chevron {
		transform: rotate(-135deg) translateY(1px);
	}

	.lang-dropdown__menu {
		position: absolute;
		top: calc(100% + 0.45rem);
		right: 0;
		z-index: 120;
		display: grid;
		gap: 0.2rem;
		min-width: min(16rem, calc(100vw - 2rem));
		max-height: min(18rem, 60vh);
		padding: 0.35rem;
		border-radius: 0.85rem;
		border: 1px solid rgba(129, 140, 248, 0.22);
		background: rgba(12, 10, 22, 0.98);
		backdrop-filter: blur(16px);
		box-shadow:
			0 16px 40px rgba(0, 0, 0, 0.42),
			0 0 0 1px rgba(99, 102, 241, 0.08);
		overflow-y: auto;
		overscroll-behavior: contain;
		scrollbar-width: thin;
	}

	.lang-dropdown__menu[hidden] {
		display: none;
	}

	.lang-dropdown__option {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.65rem 0.7rem;
		border-radius: 0.65rem;
		color: var(--color-muted);
		text-decoration: none;
		transition:
			background 0.2s ease,
			color 0.2s ease;
	}

	.lang-dropdown__option:hover {
		background: rgba(99, 102, 241, 0.14);
		color: var(--color-ink);
	}

	.lang-dropdown__option.is-active {
		background: rgba(76, 29, 149, 0.34);
		color: #f5f3ff;
	}

	.lang-dropdown__option-text {
		display: grid;
		gap: 0.1rem;
		min-width: 0;
	}

	.lang-dropdown__option-label {
		font-size: 0.82rem;
		font-weight: 700;
		line-height: 1.2;
	}

	.lang-dropdown__option-country {
		font-size: 0.68rem;
		color: var(--color-faint);
		line-height: 1.2;
	}

	.lang-dropdown__option.is-active .lang-dropdown__option-country {
		color: rgba(245, 243, 255, 0.72);
	}

	@media (max-width: 980px) {
		.lang-dropdown {
			width: 100%;
		}

		.lang-dropdown__trigger {
			width: 100%;
			max-width: none;
			min-height: 2.85rem;
		}

		.lang-dropdown__menu {
			left: 0;
			right: 0;
			min-width: 0;
		}
	}

	@media (max-width: 420px) {
		.lang-dropdown__trigger {
			min-width: 0;
		}
	}
</style>
