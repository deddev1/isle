---
import { productInfo, siteConfig } from '../data/site';

const monthlyPlan = productInfo.plans.find((plan) => plan.id === 'monthly');
const isLocalDev = import.meta.env.DEV;
---

{isLocalDev && (
	<aside class="sale-popup sale-popup--closed" data-sale-popup aria-live="polite" aria-label="Buy offer">
		<div class="sale-popup__stage">
			<button type="button" class="sale-popup__close" data-sale-popup-close aria-label="Dismiss">
				<span aria-hidden="true">&times;</span>
			</button>

			<div class="sale-popup__character">
				<svg
					class="sale-popup__dino"
					viewBox="0 0 200 220"
					role="img"
					aria-label="Cute cartoon dinosaur"
					xmlns="http://www.w3.org/2000/svg"
				>
					<defs>
						<linearGradient id="cartoon-body" x1="0%" y1="0%" x2="100%" y2="100%">
							<stop offset="0%" stop-color="#86efac" />
							<stop offset="100%" stop-color="#4ade80" />
						</linearGradient>
						<linearGradient id="cartoon-belly" x1="0%" y1="0%" x2="0%" y2="100%">
							<stop offset="0%" stop-color="#bbf7d0" />
							<stop offset="100%" stop-color="#86efac" />
						</linearGradient>
						<linearGradient id="cartoon-spots" x1="0%" y1="0%" x2="100%" y2="100%">
							<stop offset="0%" stop-color="#22c55e" />
							<stop offset="100%" stop-color="#16a34a" />
						</linearGradient>
					</defs>

					<ellipse cx="78" cy="188" rx="34" ry="8" fill="rgba(0,0,0,0.18)" />

					<path
						d="M38 170 C28 188 40 204 64 202 C88 200 98 182 94 162 C90 142 68 132 50 138 C36 143 30 154 38 170 Z"
						fill="url(#cartoon-body)"
						stroke="#15803d"
						stroke-width="2"
					/>
					<ellipse cx="62" cy="168" rx="18" ry="22" fill="url(#cartoon-belly)" />

					<path
						d="M44 118 C32 128 26 148 34 168 C42 188 64 198 88 194 C112 190 126 170 122 144 C118 118 98 98 72 94 C56 92 48 104 44 118 Z"
						fill="url(#cartoon-body)"
						stroke="#15803d"
						stroke-width="2"
					/>
					<circle cx="58" cy="132" r="5" fill="url(#cartoon-spots)" opacity="0.55" />
					<circle cx="82" cy="148" r="4" fill="url(#cartoon-spots)" opacity="0.45" />

					<path
						d="M30 96 C14 92 4 106 6 122 C8 138 24 150 44 148 C54 147 62 140 64 130 C66 116 44 100 30 96 Z"
						fill="url(#cartoon-body)"
						stroke="#15803d"
						stroke-width="2"
					/>
					<circle cx="22" cy="112" r="5.5" fill="#fff" />
					<circle cx="23" cy="112" r="2.8" fill="#1e293b" />
					<circle cx="24.5" cy="110.5" r="1" fill="#fff" />
					<path d="M10 124 C14 128 18 128 22 126" fill="none" stroke="#15803d" stroke-width="2" stroke-linecap="round" />
					<path d="M8 118 L2 116 L8 122 Z" fill="#15803d" />
					<path d="M8 124 L0 126 L8 128 Z" fill="#15803d" />

					<path
						d="M88 136 C102 132 118 136 132 146"
						fill="none"
						stroke="#15803d"
						stroke-width="10"
						stroke-linecap="round"
					/>
					<path
						d="M118 146 C132 152 146 148 158 136"
						fill="none"
						stroke="#15803d"
						stroke-width="9"
						stroke-linecap="round"
					/>
					<circle cx="134" cy="142" r="5" fill="#86efac" stroke="#15803d" stroke-width="1.5" />
					<circle cx="152" cy="138" r="4.5" fill="#86efac" stroke="#15803d" stroke-width="1.5" />
				</svg>

				<div class="sale-popup__banner">
					<div class="sale-popup__banner-face">
						<p class="sale-popup__title">The Isle Cheats</p>
						<p class="sale-popup__price">${monthlyPlan?.price ?? 35}<span>/mo</span></p>
						<a href={siteConfig.checkoutUrl} class="sale-popup__buy">Buy</a>
					</div>
					<span class="sale-popup__pole" aria-hidden="true"></span>
				</div>
			</div>
		</div>
	</aside>
)}

{isLocalDev && (
	<script is:inline>
		(function () {
			var STORAGE_KEY = 'isle-cartoon-popup-local';
			var SHOW_DELAY_MS = 800;

			function initSalePopup() {
				var popup = document.querySelector('[data-sale-popup]');
				if (!(popup instanceof HTMLElement)) return;

				var closeBtn = popup.querySelector('[data-sale-popup-close]');
				var buyLink = popup.querySelector('.sale-popup__buy');

				function hidePopup(persist) {
					popup.classList.remove('is-visible');
					popup.classList.add('sale-popup--closed');
					if (persist) {
						try {
							sessionStorage.setItem(STORAGE_KEY, '1');
						} catch (err) {
							/* ignore */
						}
					}
				}

				function showPopup() {
					popup.classList.remove('sale-popup--closed');
					window.requestAnimationFrame(function () {
						window.requestAnimationFrame(function () {
							popup.classList.add('is-visible');
						});
					});
				}

				var dismissed = false;
				try {
					dismissed = sessionStorage.getItem(STORAGE_KEY) === '1';
				} catch (err) {
					dismissed = false;
				}

				if (!dismissed) window.setTimeout(showPopup, SHOW_DELAY_MS);

				if (closeBtn) closeBtn.addEventListener('click', function () { hidePopup(true); });
				if (buyLink) buyLink.addEventListener('click', function () { hidePopup(true); });
				document.addEventListener('keydown', function (event) {
					if (event.key === 'Escape' && popup.classList.contains('is-visible')) hidePopup(true);
				});
			}

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', initSalePopup);
			} else {
				initSalePopup();
			}
		})();
	</script>
)}

<style>
	.sale-popup {
		position: fixed;
		right: max(0.75rem, env(safe-area-inset-right, 0px));
		bottom: max(0.5rem, env(safe-area-inset-bottom, 0px));
		z-index: 9999;
		width: min(15rem, calc(100vw - 1.25rem));
		pointer-events: auto;
		perspective: 820px;
		transform: translate3d(0, 0, 0);
		opacity: 1;
		visibility: visible;
		transition:
			transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.35s ease,
			visibility 0.35s ease;
	}

	.sale-popup--closed {
		pointer-events: none;
		transform: translate3d(115%, 12px, 0) scale(0.92);
		opacity: 0;
		visibility: hidden;
	}

	.sale-popup.is-visible {
		transform: translate3d(0, 0, 0) scale(1);
		opacity: 1;
		visibility: visible;
		pointer-events: auto;
	}

	.sale-popup__stage {
		position: relative;
		height: 13rem;
		transform-style: preserve-3d;
	}

	.sale-popup__close {
		position: absolute;
		top: 0;
		right: 0;
		z-index: 4;
		display: grid;
		place-items: center;
		width: 1.5rem;
		height: 1.5rem;
		border: 0;
		border-radius: 999px;
		background: rgba(10, 6, 18, 0.82);
		border: 1px solid rgba(168, 85, 247, 0.28);
		color: #ede9fe;
		font-size: 0.95rem;
		cursor: pointer;
	}

	.sale-popup__close:hover {
		background: rgba(76, 29, 149, 0.88);
	}

	.sale-popup__character {
		position: relative;
		width: 100%;
		height: 100%;
		transform-style: preserve-3d;
	}

	.sale-popup.is-visible .sale-popup__character {
		animation:
			sale-pop-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) both,
			sale-bob 4.2s ease-in-out 0.6s infinite;
	}

	.sale-popup__dino {
		position: absolute;
		left: -0.25rem;
		bottom: 0.2rem;
		width: 7rem;
		height: auto;
		transform: translate3d(0, 0, 0) rotateY(10deg);
		filter: drop-shadow(0 12px 16px rgba(0, 0, 0, 0.28));
	}

	.sale-popup__banner {
		position: absolute;
		right: 0;
		bottom: 2.35rem;
		width: 9.5rem;
		transform-style: preserve-3d;
		transform: translate3d(0, 0, 32px) rotateY(-12deg) rotateX(8deg);
	}

	.sale-popup.is-visible .sale-popup__banner {
		animation: sale-banner-sway 3.8s ease-in-out 0.6s infinite;
	}

	.sale-popup__banner-face {
		position: relative;
		display: grid;
		gap: 0.18rem;
		padding: 0.7rem 0.75rem 0.75rem;
		border-radius: 0.55rem;
		border: 2px solid #fcd34d;
		background: linear-gradient(165deg, #fff7d6 0%, #fde68a 55%, #fbbf24 100%);
		box-shadow:
			0 14px 26px rgba(0, 0, 0, 0.28),
			inset 0 1px 0 rgba(255, 255, 255, 0.65);
	}

	.sale-popup__pole {
		position: absolute;
		left: 0.5rem;
		bottom: -1.75rem;
		width: 0.32rem;
		height: 1.9rem;
		border-radius: 0.15rem;
		background: linear-gradient(90deg, #92400e, #d97706);
		transform: translateZ(-6px);
	}

	.sale-popup__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: 0.78rem;
		font-weight: 900;
		line-height: 1.1;
		color: #422006;
	}

	.sale-popup__price {
		margin: 0;
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 900;
		line-height: 1;
		color: #1c0f02;
	}

	.sale-popup__price span {
		font-size: 0.7rem;
		font-weight: 800;
		color: #78350f;
	}

	.sale-popup__buy {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 1.85rem;
		margin-top: 0.15rem;
		border-radius: 0.45rem;
		background: var(--gradient-brand);
		color: #fff;
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		box-shadow: 0 6px 14px rgba(76, 29, 149, 0.4);
		transition: transform 0.2s ease, filter 0.2s ease;
	}

	.sale-popup__buy:hover {
		transform: translateY(-1px);
		filter: brightness(1.06);
		color: #fff;
	}

	.sale-popup__close:focus-visible,
	.sale-popup__buy:focus-visible {
		outline: 2px solid rgba(167, 139, 250, 0.85);
		outline-offset: 2px;
	}

	@keyframes sale-pop-in {
		from {
			transform: translate3d(36px, 24px, -30px) rotateY(16deg) scale(0.88);
			opacity: 0.15;
		}
		to {
			transform: translate3d(0, 0, 0) rotateY(0deg) scale(1);
			opacity: 1;
		}
	}

	@keyframes sale-bob {
		0%,
		100% {
			transform: translate3d(0, 0, 0);
		}
		50% {
			transform: translate3d(0, -5px, 0);
		}
	}

	@keyframes sale-banner-sway {
		0%,
		100% {
			transform: translate3d(0, 0, 32px) rotateY(-12deg) rotateX(8deg);
		}
		50% {
			transform: translate3d(0, -2px, 36px) rotateY(-9deg) rotateX(6deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.sale-popup,
		.sale-popup__character,
		.sale-popup__banner {
			animation: none !important;
			transition-duration: 0.01ms;
		}
	}

	@media (max-width: 420px) {
		.sale-popup {
			width: min(13.5rem, calc(100vw - 1rem));
		}

		.sale-popup__stage {
			height: 12rem;
		}

		.sale-popup__dino {
			width: 6.2rem;
		}

		.sale-popup__banner {
			width: 8.75rem;
			bottom: 2.1rem;
		}
	}
</style>
