---
import { cloudDmaOption, productInfo, siteConfig } from '../data/site';
import { getHomeContent } from '../data/i18n/home-content';
import { getRelatedSearchTerms } from '../data/i18n/search-terms';
import { getLocalizedPath, type LocaleCode } from '../data/i18n';

interface Props {
	locale?: LocaleCode;
}

const { locale = 'en' } = Astro.props;
const content = getHomeContent(locale);
const searchTerms = getRelatedSearchTerms(locale);
const pricingHref = getLocalizedPath('/pricing/', locale);
const packageIntro = content.packageIntro.replace('{cloudDma}', cloudDmaOption.label);
const shareUrl = encodeURIComponent(siteConfig.url + getLocalizedPath('/', locale));
const shareText = encodeURIComponent('The Isle Cheats - ESP and hacks for The Isle players');
---

<section class="home-seo shell" aria-labelledby="home-seo-title">
	<div class="home-seo__panel card-surface">
		<h2 id="home-seo-title">{content.whyUsHeading}</h2>
		<p>{content.whyUsIntro}</p>
		<ul class="home-seo__bullets">
			{content.whyUsPoints.map((point) => (
				<li>{point}</li>
			))}
		</ul>

		<div class="home-seo__grid">
			{
				content.gridLinks.map((link) => (
					<article>
						<h3>
							<a href={link.href === '/pricing/' ? pricingHref : link.href}>{link.title}</a>
						</h3>
						<p>{link.description}</p>
					</article>
				))
			}
		</div>
	</div>

	<div class="home-seo__panel card-surface">
		<h2>{content.packageHeading}</h2>
		<p>{packageIntro}</p>
		<ul>
			{productInfo.features.visualsEsp.slice(0, 6).map((item) => <li>{item}</li>)}
			{productInfo.features.cheats.map((item) => <li>{item}</li>)}
			{productInfo.features.general.map((item) => <li>{item}</li>)}
		</ul>
		<p>{content.packageOutro}</p>
	</div>

	<section class="home-seo__panel card-surface" id="undetected" data-nav-section="undetected">
		<h2>{content.evaluateHeading}</h2>
		<p>{content.evaluateParagraphs[0]}</p>
		<p>{content.evaluateParagraphs[1]}</p>
		<p>{content.evaluateParagraphs[2]}</p>
	</section>

	<section class="home-seo__faq" id="blog" data-nav-section="blog" aria-labelledby="home-faq-title">
		<h2 id="home-faq-title">{content.faqHeading}</h2>
		<div class="home-seo__faq-list">
			{
				content.faqs.map((item) => (
					<details class="home-seo__item">
						<summary>{item.question}</summary>
						<p>{item.answer}</p>
					</details>
				))
			}
		</div>
		<p class="home-seo__more">{content.faqMore}</p>
	</section>

	<section class="home-seo__share" aria-labelledby="share-title">
		<h2 id="share-title">{content.shareHeading}</h2>
		<p>{content.shareIntro}</p>
		<div class="home-seo__share-row">
			<a
				class="share-link"
				href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`}
				target="_blank"
				rel="noopener noreferrer"
			>
				Share on X
			</a>
			<a
				class="share-link"
				href={`https://www.facebook.com/sharer/sharer.php?u=${shareUrl}`}
				target="_blank"
				rel="noopener noreferrer"
			>
				Share on Facebook
			</a>
			<a
				class="share-link"
				href={`https://www.reddit.com/submit?url=${shareUrl}&title=${shareText}`}
				target="_blank"
				rel="noopener noreferrer"
			>
				Share on Reddit
			</a>
			<a
				class="share-link"
				href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
				target="_blank"
				rel="noopener noreferrer"
			>
				Share on LinkedIn
			</a>
		</div>
	</section>

	<nav class="home-seo__searches" aria-label={content.relatedSearchesLabel}>
		<p class="home-seo__searches-label">{content.relatedSearchesLabel}</p>
		<ul class="home-seo__searches-list">
			{
				searchTerms.map((term) => (
					<li>
						<a href={term.href}>{term.label}</a>
					</li>
				))
			}
		</ul>
	</nav>
</section>

<style>
	.home-seo {
		display: grid;
		gap: 1.5rem;
		padding-bottom: 1rem;
	}

	.card-surface {
		padding: clamp(1.25rem, 3vw, 1.75rem);
		border-radius: var(--radius-card);
		border: 1px solid rgba(168, 85, 247, 0.16);
		background: rgba(26, 22, 38, 0.72);
	}

	.home-seo h2 {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.35rem, 2.5vw, 1.75rem);
		font-weight: 800;
	}

	.home-seo p {
		margin: 0.85rem 0 0;
		color: var(--color-muted);
		line-height: 1.65;
	}

	.home-seo ul,
	.home-seo__bullets {
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
		display: grid;
		gap: 0.45rem;
	}

	.home-seo li,
	.home-seo__bullets li {
		position: relative;
		padding: 0.55rem 0.75rem 0.55rem 1.85rem;
		border-radius: 0.65rem;
		border: 1px solid rgba(168, 85, 247, 0.1);
		background: rgba(10, 6, 18, 0.35);
		color: #d4cae6;
		font-size: 0.94rem;
		line-height: 1.5;
	}

	.home-seo li::before,
	.home-seo__bullets li::before {
		content: '';
		position: absolute;
		left: 0.75rem;
		top: 50%;
		width: 0.35rem;
		height: 0.35rem;
		border-radius: 999px;
		background: var(--color-orchid);
		transform: translateY(-50%);
	}

	.home-seo a {
		color: var(--color-orchid);
		font-weight: 600;
	}

	.home-seo a:hover {
		color: var(--color-ink);
	}

	.home-seo__grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.85rem;
		margin-top: 1.35rem;
	}

	.home-seo__grid article {
		padding: 1rem;
		border-radius: 0.9rem;
		border: 1px solid rgba(168, 85, 247, 0.14);
		background: rgba(10, 6, 18, 0.35);
	}

	.home-seo__grid h3 {
		margin: 0;
		font-size: 1rem;
		font-weight: 750;
	}

	.home-seo__grid p {
		margin-top: 0.45rem;
		font-size: 0.92rem;
	}

	.home-seo__faq-list {
		display: grid;
		gap: 0.65rem;
		margin-top: 1rem;
	}

	.home-seo__item {
		border-radius: 0.85rem;
		border: 1px solid rgba(168, 85, 247, 0.14);
		background: rgba(26, 22, 38, 0.65);
		padding: 0.85rem 1rem;
	}

	.home-seo__item summary {
		cursor: pointer;
		font-weight: 700;
		color: var(--color-ink);
	}

	.home-seo__item p {
		margin-top: 0.65rem;
	}

	.home-seo__more {
		font-size: 0.92rem;
	}

	.home-seo__share {
		padding: clamp(1.1rem, 2.5vw, 1.5rem);
		border-radius: var(--radius-card);
		border: 1px solid rgba(168, 85, 247, 0.14);
		background: rgba(18, 16, 26, 0.55);
	}

	.home-seo__share-row {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 1rem;
	}

	.share-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		min-height: 2.5rem;
		padding: 0.55rem 0.95rem;
		border-radius: 0.7rem;
		border: 1px solid rgba(192, 132, 252, 0.25);
		background: rgba(34, 28, 48, 0.85);
		color: var(--color-ink) !important;
		font-size: 0.88rem;
		font-weight: 700;
		transition:
			border-color 0.2s ease,
			background 0.2s ease;
	}

	.share-link:hover {
		border-color: rgba(192, 132, 252, 0.5);
		background: rgba(48, 36, 72, 0.9);
	}

	.home-seo__searches {
		padding: 0.85rem 0 0.25rem;
		border-top: 1px solid rgba(168, 85, 247, 0.08);
	}

	.home-seo__searches-label {
		margin: 0;
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(148, 163, 184, 0.55);
	}

	.home-seo__searches-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem 0.5rem;
		margin: 0.55rem 0 0;
		padding: 0;
		list-style: none;
	}

	.home-seo__searches-list a {
		display: inline-flex;
		align-items: center;
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
		border: 1px solid rgba(168, 85, 247, 0.08);
		background: rgba(10, 6, 18, 0.25);
		color: rgba(148, 163, 184, 0.72);
		font-size: 0.72rem;
		font-weight: 600;
		line-height: 1.35;
	}

	.home-seo__searches-list a:hover {
		color: var(--color-muted);
		border-color: rgba(168, 85, 247, 0.2);
	}

	@media (max-width: 720px) {
		.home-seo__grid {
			grid-template-columns: 1fr;
		}
	}
</style>
