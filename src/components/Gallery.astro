---
import { theIsleImages } from '../data/theisle';

const images = theIsleImages.gallery.slice(0, 4);
---

<section class="gallery" id="gallery" aria-labelledby="gallery-title">
	<header class="gallery__head">
		<h2 id="gallery-title" class="gallery__title">Feature gallery</h2>
		<p class="gallery__sub">ESP, combat, and map tools in action.</p>
	</header>

	<div class="gallery__grid">
		{
			images.map((image) => (
				<figure class="gallery__item">
					<img src={image.src} alt={image.alt} width="640" height="400" loading="lazy" decoding="async" />
				</figure>
			))
		}
	</div>
</section>

<style>
	.gallery {
		width: 100%;
		display: grid;
		gap: 0.75rem;
	}

	.gallery__head {
		display: grid;
		gap: 0.25rem;
	}

	.gallery__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.2rem, 2.2vw, 1.5rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}

	.gallery__sub {
		margin: 0;
		color: var(--color-muted);
		font-size: 0.88rem;
		line-height: 1.4;
	}

	.gallery__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.5rem;
	}

	.gallery__item {
		margin: 0;
		overflow: hidden;
		border-radius: 0.55rem;
		border: 1px solid rgba(168, 85, 247, 0.14);
		background: #12081f;
		aspect-ratio: 16 / 10;
	}

	.gallery__item img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	@media (max-width: 800px) {
		.gallery__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (max-width: 420px) {
		.gallery__grid {
			grid-template-columns: 1fr 1fr;
			gap: 0.4rem;
		}
	}
</style>
