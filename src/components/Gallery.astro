---
import { theIsleImages } from '../data/theisle';

const images = theIsleImages.gallery.slice(0, 10);
---

<section class="gallery" id="gallery" aria-labelledby="gallery-title">
	<header class="gallery__head">
		<h2 id="gallery-title" class="gallery__title">Feature gallery</h2>
		<p class="gallery__sub">ESP, combat, and map tools in action.</p>
	</header>

	<div class="gallery__marquee" aria-label="Feature gallery image scroller">
		<div class="gallery__track">
			<div class="gallery__group">
				{
					images.map((image) => (
						<figure class="gallery__item">
							<img src={image.src} alt={image.alt} width="640" height="400" loading="lazy" decoding="async" />
						</figure>
					))
				}
			</div>
			<div class="gallery__group" aria-hidden="true">
				{
					images.map((image) => (
						<figure class="gallery__item">
							<img src={image.src} alt="" width="640" height="400" loading="lazy" decoding="async" />
						</figure>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.gallery {
		width: 100%;
		display: grid;
		gap: 0.75rem;
	}

	.gallery__head {
		display: grid;
		gap: 0.25rem;
	}

	.gallery__title {
		margin: 0;
		font-family: var(--font-display);
		font-size: clamp(1.2rem, 2.2vw, 1.5rem);
		font-weight: 800;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}

	.gallery__sub {
		margin: 0;
		color: var(--color-muted);
		font-size: 0.88rem;
		line-height: 1.4;
	}

	.gallery__marquee {
		overflow: hidden;
		mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
		-webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
	}

	.gallery__track {
		display: flex;
		flex-wrap: nowrap;
		gap: 0.5rem;
		width: max-content;
		animation: gallery-marquee 40s linear infinite;
	}

	.gallery__marquee:hover .gallery__track {
		animation-play-state: paused;
	}

	.gallery__group {
		display: flex;
		flex-wrap: nowrap;
		gap: 0.5rem;
	}

	.gallery__item {
		flex: 0 0 clamp(9.5rem, 18vw, 13.5rem);
		margin: 0;
		overflow: hidden;
		border-radius: 0.55rem;
		border: 1px solid rgba(168, 85, 247, 0.14);
		background: #12081f;
		aspect-ratio: 16 / 10;
	}

	.gallery__item img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		pointer-events: none;
	}

	@keyframes gallery-marquee {
		from {
			transform: translateX(0);
		}
		to {
			/* Move exactly one group + the gap between groups */
			transform: translateX(calc(-50% - 0.25rem));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.gallery__track {
			animation: none;
			max-width: 100%;
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			scrollbar-width: thin;
		}

		.gallery__group[aria-hidden='true'] {
			display: none;
		}

		.gallery__item {
			flex-basis: 10rem;
		}
	}
</style>
