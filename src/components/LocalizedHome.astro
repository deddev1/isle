---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import HomeVideoPlayer from '../components/HomeVideoPlayer.astro';
import ProductCard from '../components/ProductCard.astro';
import Gallery from '../components/Gallery.astro';
import HomeSeo from '../components/HomeSeo.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { productInfo, siteConfig } from '../data/site';
import { getPageSeo } from '../data/seo/meta';
import { getHomeMetaKeywords, getRelatedSearchTerms } from '../data/i18n/search-terms';
import { organizationAlternateNames } from '../data/seo/keywords';
import { buildFaqSchema, buildRelatedSearchesSchema, buildSoftwareApplicationSchema } from '../data/seo/schema';
import { getHomeContent } from '../data/i18n/home-content';
import { getLocalizedPath } from '../data/i18n';
import type { LocaleCode } from '../data/i18n';

interface Props {
	locale: LocaleCode;
}

const { locale } = Astro.props;
const seo = getPageSeo('home', locale);
const homeContent = getHomeContent(locale);
const pricingUrl = new URL(getLocalizedPath('/pricing/', locale), siteConfig.url).href;

const productSchema = buildSoftwareApplicationSchema({
	name: productInfo.name,
	description: productInfo.summary,
	pricingUrl,
	plans: productInfo.plans,
	currency: productInfo.currency,
	alternateName: [...organizationAlternateNames],
	keywords: getHomeMetaKeywords(locale),
});

const faqSchema = buildFaqSchema(homeContent.faqs);
const relatedSearchesSchema = buildRelatedSearchesSchema(getRelatedSearchTerms(locale), locale);
const canonicalPath = getLocalizedPath('/', locale);
---

<Layout
	title={seo.title}
	description={seo.description}
	canonicalPath={canonicalPath}
	ogImage="/images/the-isle-hero-dinosaur-survival.webp"
	preloadImage="/images/the-isle-hero-dinosaur-survival.webp"
	locale={locale}
	keywords={getHomeMetaKeywords(locale)}
	ogTitle={seo.ogTitle}
	ogDescription={seo.ogDescription}
	twitterTitle={seo.twitterTitle}
	twitterDescription={seo.twitterDescription}
>
	<script type="application/ld+json" set:html={JSON.stringify(productSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	<script type="application/ld+json" set:html={JSON.stringify(relatedSearchesSchema)} />
	<Navbar />
	<main class="site">
		<Hero locale={locale} />
		<section class="site__section" id="features" data-nav-section="features" aria-label="Product packages">
			<div class="shell">
				<div class="product-showcase">
					<div class="product-showcase__video">
						<HomeVideoPlayer />
					</div>
					<div class="product-showcase__product">
						<ProductCard variant="showcase" />
					</div>
				</div>
			</div>
		</section>
		<section class="site__section site__section--seo" id="why-us" data-nav-section="why-us">
			<HomeSeo locale={locale} />
		</section>
		<section class="site__section site__section--gallery" id="demo" data-nav-section="demo">
			<div class="shell">
				<Gallery />
			</div>
		</section>
		<SiteFooter locale={locale} />
	</main>
</Layout>

<style>
	.site {
		overflow-x: clip;
	}

	.site__section {
		padding-block: var(--section-space);
	}

	.site__section--seo {
		padding-top: 0.25rem;
	}

	.site__section--gallery {
		padding-top: 0.5rem;
		padding-bottom: 2rem;
	}

	.product-showcase {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.25rem;
		align-items: stretch;
	}

	.product-showcase__video,
	.product-showcase__product {
		display: flex;
		min-width: 0;
		min-height: 0;
	}

	.product-showcase__video :global(article),
	.product-showcase__product :global(.product) {
		width: 100%;
	}

	@media (min-width: 1024px) {
		.product-showcase {
			grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
			gap: 1.75rem;
			min-height: clamp(520px, 42vw, 680px);
		}

		.product-showcase__video,
		.product-showcase__product {
			height: 100%;
		}
	}

	@media (max-width: 640px) {
		.product-showcase {
			gap: 1rem;
		}
	}
</style>
