---
import '../styles/global.css';
import { getLocalizedPath, getOgLocale, getLocaleDir, getHreflangAlternates, getXDefaultPath, locales, type LocaleCode } from '../data/i18n';
import { siteConfig } from '../data/site';
import { organizationAlternateNames, organizationKnowsAbout } from '../data/seo/keywords';

interface Props {
	title: string;
	description: string;
	canonicalPath?: string;
	ogImage?: string;
	ogTitle?: string;
	ogDescription?: string;
	twitterTitle?: string;
	twitterDescription?: string;
	keywords?: string;
	noindex?: boolean;
	includeCanonical?: boolean;
	type?: 'website' | 'article';
	locale?: LocaleCode;
	preloadImage?: string;
	articlePublished?: string;
	articleModified?: string;
}

const {
	title,
	description,
	canonicalPath = Astro.url.pathname,
	ogImage = siteConfig.defaultOgImage,
	ogTitle = title,
	ogDescription = description,
	twitterTitle = title,
	twitterDescription = description,
	keywords = siteConfig.keywords,
	noindex = false,
	includeCanonical = true,
	type = 'website',
	locale = 'en',
	preloadImage,
	articlePublished,
	articleModified,
} = Astro.props;

const path = canonicalPath.endsWith('/') || canonicalPath.includes('.') ? canonicalPath : `${canonicalPath}/`;
const canonicalURL = new URL(path === '//' ? '/' : path, siteConfig.url).href;
const ogImageURL = new URL(ogImage, siteConfig.url).href;
const logoURL = new URL(siteConfig.logo, siteConfig.url).href;
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const ogLocale = getOgLocale(locale);
const dir = getLocaleDir(locale);
const alternateLinks = getHreflangAlternates(path).map((entry) => ({
	hreflang: entry.hrefLang,
	href: new URL(entry.href, siteConfig.url).href,
}));
const xDefaultHref = new URL(getXDefaultPath(path), siteConfig.url).href;
const websiteLanguages = locales.map((entry) => entry.code);
---

<!doctype html>
<html lang={locale} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#0a0612" />
		<meta name="robots" content={robots} />
		<meta name="googlebot" content={robots} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="author" content={siteConfig.name} />
		<meta name="distribution" content="global" />
		<meta name="coverage" content="Worldwide" />
		<meta name="target" content="all" />
		{includeCanonical && <link rel="canonical" href={canonicalURL} />}
		{
			alternateLinks.map((alternate) => (
				<link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
			))
		}
		<link rel="alternate" hreflang="x-default" href={xDefaultHref} />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
		<link rel="alternate" type="application/rss+xml" title="The Isle Blog RSS" href="/rss.xml" />
		{preloadImage && (
			<link rel="preload" as="image" href={new URL(preloadImage, siteConfig.url).href} fetchpriority="high" />
		)}

		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={siteConfig.name} />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:alt" content={ogTitle} />
		<meta property="og:locale" content={ogLocale} />
		{type === 'article' && articlePublished && (
			<meta property="article:published_time" content={articlePublished} />
		)}
		{type === 'article' && articleModified && (
			<meta property="article:modified_time" content={articleModified} />
		)}
		{type === 'article' && (
			<meta property="article:author" content={siteConfig.name} />
		)}
		{
			locales
				.filter((entry) => entry.code !== locale)
				.map((entry) => (
					<meta property="og:locale:alternate" content={entry.ogLocale} />
				))
		}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={twitterTitle} />
		<meta name="twitter:description" content={twitterDescription} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={twitterTitle} />

		{!noindex && (
			<script
				type="application/ld+json"
				set:html={JSON.stringify({
					'@context': 'https://schema.org',
					'@graph': [
						{
							'@type': 'WebSite',
							'@id': `${siteConfig.url}/#website`,
							url: siteConfig.url,
							name: siteConfig.name,
							description,
							inLanguage: websiteLanguages,
							areaServed: {
								'@type': 'Place',
								name: 'Worldwide',
							},
							audience: {
								'@type': 'Audience',
								geographicArea: {
									'@type': 'Place',
									name: 'Worldwide',
								},
							},
							potentialAction: {
								'@type': 'SearchAction',
								target: `${siteConfig.url}/blog/?q={search_term_string}`,
								'query-input': 'required name=search_term_string',
							},
						},
						{
							'@type': 'Organization',
							'@id': `${siteConfig.url}/#organization`,
							name: siteConfig.name,
							alternateName: [...organizationAlternateNames],
							knowsAbout: [...organizationKnowsAbout],
							areaServed: {
								'@type': 'Place',
								name: 'Worldwide',
							},
							url: siteConfig.url,
							email: siteConfig.supportEmail,
							logo: {
								'@type': 'ImageObject',
								url: logoURL,
							},
							image: logoURL,
							sameAs: [],
						},
					],
				})}
			/>
		)}

		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
